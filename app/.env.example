# Copy to .env and fill in. Do not commit .env.
# Configuration lives in steuererklaerung.json (v1 manifest); this file holds only SECRETS + connection URLs.
# Optional: point at a manifest outside the current directory.
# STEUER_WORKSPACE=

# Qonto – switch with QONTO_ENV=production|staging. You can set both credential sets and only change QONTO_ENV.
QONTO_ENV=production

# Production (used when QONTO_ENV=production). From Qonto web app → Integrations and Partnerships → API key.
QONTO_PRODUCTION_SIGN_IN=
QONTO_PRODUCTION_SECRET_KEY=
# Optional: default bank account ID for "qonto transactions" when using production
QONTO_PRODUCTION_DEFAULT_BANK_ACCOUNT_ID=

# Staging/Sandbox (used when QONTO_ENV=staging). Two credential sources:
# 1) Developer Portal → "Sandbox access" → X-Qonto-Staging-Token value → QONTO_STAGING_TOKEN
# 2) Developer Portal → Toolkit → "Sandbox web app" → Integrations and Partnerships → API key (Sign-in + Secret key)
QONTO_STAGING_SIGN_IN=
QONTO_STAGING_SECRET_KEY=
QONTO_STAGING_TOKEN=
# Optional: default bank account ID for "qonto transactions" when using staging
QONTO_STAGING_DEFAULT_BANK_ACCOUNT_ID=

# Fallback (if prefixed vars above are not set): QONTO_SIGN_IN, QONTO_SECRET_KEY, QONTO_DEFAULT_BANK_ACCOUNT_ID
# Optional override for base URL (defaults per env: production → thirdparty.qonto.com, staging → thirdparty-sandbox.staging.qonto.co)
# QONTO_BASE_URL=

# Paperless-NGX (base URL + token from "My Profile")
PAPERLESS_BASE_URL=https://paperless.example.com
PAPERLESS_API_TOKEN=

# ELSTER (e.g. USt-VA XML generation: elster ustva generate-xml)
# Optional: tax number; can also be set in the entity's `elster` section of steuererklaerung.json
# ELSTER_TAX_NUMBER=

# INWX domain registrar (for invoice fetching: invoices inwx list/download/import)
INWX_USERNAME=
INWX_PASSWORD=
# Optional: TOTP shared secret for 2FA
# INWX_SHARED_SECRET=
# Optional: live|ote (default: live). Use ote for testing.
# INWX_ENV=live

# FinTS/HBCI (for bank accounts reached over HBCI: fints sync, fints transactions)
# PIN per account: FINTS_PIN_<account_name> (name from the `fints` section of steuererklaerung.json, lowercase, hyphens → underscores)
# FINTS_PIN_musterbank_privat=
# Optional: directory for persisted banking data (default: cwd/fints-data)
# FINTS_DATA_DIR=

# Scaleway Generative APIs — optional fallback LLM engine (use LLM_PROVIDER=scaleway).
# Default engine is Claude on your subscription (see "Pluggable LLM engine" below).
SCALEWAY_API_KEY=
# If set, base URL is https://api.scaleway.ai/{project_id}/v1
SCALEWAY_PROJECT_ID=
# Otherwise use this (default below)
SCALEWAY_BASE_URL=https://api.scaleway.ai/v1
# Optional: chat model (default: mistral-small-3.2-24b-instruct-2506)
# SCALEWAY_CHAT_MODEL=mistral-small-3.2-24b-instruct-2506

# Pluggable LLM engine (src/core/clients/llm) — selects the reasoning provider used by
# the Paperless review/classify/extract actions.
#   LLM_PROVIDER: claude (default, Claude Agent SDK via your logged-in subscription) | scaleway
#   LLM_MODEL:    model id override (e.g. claude-opus-4-8, claude-sonnet-4-6)
# The Claude provider needs no API key — it draws on the logged-in `claude` CLI
# session. Set ANTHROPIC_API_KEY only to bill per-token (e.g. in CI).
LLM_PROVIDER=claude
LLM_MODEL=claude-opus-4-8
# ANTHROPIC_API_KEY=
