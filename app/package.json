    },
    "devDependencies": {
        "@girs/adw-1": "^5.5.0",
        "@girs/gio-2.0": "^5.5.0",
        "@girs/gjs": "^5.5.0",
        "@girs/glib-2.0": "^5.5.0",
        "@girs/gobject-2.0": "^5.5.0",
        "@girs/graphene-1.0": "^5.5.0",
        "@girs/gsk-4.0": "^5.5.0",
        "@girs/gtk-4.0": "^5.5.0",
        "@gjsify/adwaita-app": "0.64.1-next.243",
        "@gjsify/adwaita-fonts": "0.64.1-next.243",
        "@gjsify/adwaita-web": "0.64.1-next.243",
        "@gjsify/app-settings": "0.64.1-next.243",
        "@gjsify/cli": "0.64.1-next.240",
        "@gjsify/devtools": "0.64.1-next.243",
        "@gjsify/distribution": "0.64.1-next.243",
        "@gjsify/node-gi": "0.64.0",
        "@gjsify/node-globals": "0.64.1-next.243",
        "@gjsify/rolldown-native": "0.64.1-next.243",
        "@gjsify/runtime": "0.64.1-next.243",
        "@gjsify/stories": "0.64.1-next.243",
        "@gjsify/storybook": "0.64.1-next.243",
        "@gjsify/unit": "0.64.1-next.243",
        "@gjsify/vite-plugin-gjsify": "0.64.1-next.243",
        "@qonto/embed-sdk": "^0.69.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "@types/yargs": "^17.0.35",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "vite": "^8.3.4"
    },
    "gjsify": {
        "storybook": {
            "applicationId": "eu.jumplink.Steuererklaerung.Storybook",
            "title": "Steuererklärung Widgets",
            "stories": "src/frontends/desktop/widgets",
            "globals": "auto"
        },
        "ship": {
            "channel": "web",
            "bundle": {
                "linux": "dist/app/steuer-app.gjs.mjs",
                "darwin": "dist/app/steuer-app.node.mjs",
                "win32": "dist/app/steuer-app.node.mjs"
            },
            "app": {
                "darwin": "node",
                "win32": "node"
            },
            "binaryName": "steuererklaerung",
            "bundledTypelibs": {
                "linux": [
                    "../node_modules/@gjsify/http-soup-bridge-linux-x64/prebuilds/linux-x64"
                ]
            },
            "extraFiles": {
                "lib/steuererklaerung/demo/steuererklaerung.json": "demo/steuererklaerung.json",
                "lib/steuererklaerung/demo/transactions-data/camt_DE76370400440532013040.ndjson": "demo/transactions-data/camt_DE76370400440532013040.ndjson",
                "lib/steuererklaerung/demo/transactions-data/fints_demo-musterbank-giro.ndjson": "demo/transactions-data/fints_demo-musterbank-giro.ndjson",
                "lib/steuererklaerung/demo/transactions-data/paypal_demo-fw.ndjson": "demo/transactions-data/paypal_demo-fw.ndjson",
                "lib/steuererklaerung/demo/transactions-data/qonto_demo-fw-geschaeft.ndjson": "demo/transactions-data/qonto_demo-fw-geschaeft.ndjson",
                "lib/steuererklaerung/demo/transactions-data/statements.json": "demo/transactions-data/statements.json"
            },
            "appId": "eu.jumplink.Steuererklaerung",
            "name": "Steuererklärung",
            "summary": "Tax return and bookkeeping for small businesses",
            "description": [
                {
                    "p": "Receipts, transactions and invoices in one place. From them the app computes the income-surplus statement (EÜR), the VAT returns, trade tax and the separate assessment for partnerships, and files them through ELSTER."
                },
                {
                    "p": "It runs on your machine: your bank data and documents stay in a local store. Every figure can be traced back to the transaction it came from."
                },
                {
                    "p": "It works fully without AI: you write your own classification rules instead of letting a model guess. An assistant is optional and off by default."
                },
                {
                    "p": "The tax logic follows German law, so the interface keeps the official German terms. The app is a preparation aid, not tax advice."
                }
            ],
            "icon": "data/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg",
            "categories": [
                "Office",
                "Finance"
            ],
            "keywords": [
                "Tax",
                "Accounting",
                "ELSTER",
                "EÜR",
                "VAT",
                "Invoice"
            ],
            "developer": {
                "id": "eu.jumplink",
                "name": "Pascal Garber"
            },
            "branding": {
                "accentLight": "#62a0ea",
                "accentDark": "#1a5fb4"
            },
            "contentRating": "oars-1.1",
            "releases": [
                {
                    "version": "0.1.0",
                    "date": "2026-10-12"
                }
            ],
            "screenshots": [
                {
                    "url": "https://raw.githubusercontent.com/JumpLink/steuererklaerung/main/docs/screenshots/01-uebersicht.png",
                    "caption": "Overview with key figures and what to do next"
                },
                {
                    "url": "https://raw.githubusercontent.com/JumpLink/steuererklaerung/main/docs/screenshots/04-belege.png",
                    "caption": "Receipts, linked to transactions"
                },
                {
                    "url": "https://raw.githubusercontent.com/JumpLink/steuererklaerung/main/docs/screenshots/05-buchungen.png",
                    "caption": "All transactions of all accounts, searchable"
                },
                {
                    "url": "https://raw.githubusercontent.com/JumpLink/steuererklaerung/main/docs/screenshots/06-rechnungen.png",
                    "caption": "Outgoing invoices with status and recurring billing"
                },
                {
                    "url": "https://raw.githubusercontent.com/JumpLink/steuererklaerung/main/docs/screenshots/10-euer.png",
                    "caption": "Anlage EÜR, every line down to its transactions"
                },
                {
                    "url": "https://raw.githubusercontent.com/JumpLink/steuererklaerung/main/docs/screenshots/09-steuererklaerung.png",
                    "caption": "Tax return with checks before filing"
                }
            ],
            "homepageUrl": "https://jumplink.eu/steuererklaerung/",
            "bugtrackerUrl": "https://github.com/JumpLink/steuererklaerung/issues",
            "vcsBrowserUrl": "https://github.com/JumpLink/steuererklaerung",
            "license": {
