{
    "name": "steuererklaerung-cli",
    "description": "CLI for steuererklaerung: Qonto, Paperless-NGX, ELSTER, FinTS",
    "version": "0.1.0",
    "license": "AGPL-3.0-or-later",
    "author": "Pascal Garber",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "start": "gjsify run dist/steuer.gjs.mjs",
        "check": "gjsify tsc --noEmit && gjsify run check:glossary && gjsify run check:fields && gjsify run check:ai && gjsify run check:cli-commands && gjsify run check:blp-handlers && gjsify run check:markup && gjsify run check:i18n",
        "check:fields": "node dev/check-field-coverage.js",
        "check:ai": "node dev/check-ai-boundary.js",
        "check:cli-commands": "node dev/check-cli-commands.js",
        "check:markup": "node dev/check-adwaita-markup.js",
        "check:glossary": "node dev/check-glossary-terms.js",
        "check:licenses": "node dev/check-licenses.js",
        "format": "gjsify format --write .",
        "format:check": "gjsify format --check .",
        "lint": "gjsify lint .",
        "lint:fix": "gjsify lint --fix .",
        "build": "gjsify run i18n:compile && gjsify run build:gjs && gjsify run build:app && gjsify run build:web",
        "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/steuer.gjs.mjs --external koffi --external @anthropic-ai/claude-agent-sdk --exclude-globals document,navigator,HTMLElement,location,Image,HTMLCanvasElement,HTMLImageElement,FontFace,matchMedia,MutationObserver,ResizeObserver,IntersectionObserver",
        "build:node": "gjsify build src/index.ts --app node --outfile dist/steuer.node.mjs --external koffi --external @anthropic-ai/claude-agent-sdk",
        "start:node": "node dist/steuer.node.mjs",
        "dev:web": "vite",
        "build:web": "vite build",
        "dev:browse": "gjsify browse http://127.0.0.1:3000 --devtools",
        "build:app": "gjsify build src/frontends/desktop/main.ts --app gjs --outfile dist/app/steuer-app.gjs.mjs --external koffi --external @anthropic-ai/claude-agent-sdk --exclude-globals document,navigator,HTMLElement,location,Image,HTMLCanvasElement,HTMLImageElement,FontFace,matchMedia,MutationObserver,ResizeObserver,IntersectionObserver",
        "build:app:node": "gjsify build src/frontends/desktop/main.ts --app node --outfile dist/app/steuer-app.node.mjs --external koffi --external @anthropic-ai/claude-agent-sdk --exclude-globals document,navigator,HTMLElement,location,Image,HTMLCanvasElement,HTMLImageElement,FontFace,matchMedia,MutationObserver,ResizeObserver,IntersectionObserver",
        "build:app:flathub": "gjsify build src/frontends/desktop/main.ts --app gjs --outfile dist/app/steuer-app.gjs.mjs --channel flathub --external koffi --external @anthropic-ai/claude-agent-sdk --exclude-globals document,navigator,HTMLElement,location,Image,HTMLCanvasElement,HTMLImageElement,FontFace,matchMedia,MutationObserver,ResizeObserver,IntersectionObserver",
        "start:app": "gjsify run dist/app/steuer-app.gjs.mjs",
        "dev:app": "gjsify run build:app && gjsify run start:app",
        "build:test:gjs": "gjsify build tests/test.mts --app gjs --outfile dist/test.gjs.mjs --no-minify --external koffi --external @anthropic-ai/claude-agent-sdk --exclude-globals document,navigator,HTMLElement,location,Image,HTMLCanvasElement,HTMLImageElement,FontFace,matchMedia,MutationObserver,ResizeObserver,IntersectionObserver",
        "build:test:node": "gjsify build tests/test.mts --app node --outfile dist/test.node.mjs --external koffi --external @anthropic-ai/claude-agent-sdk",
        "test": "gjsify run build:test:gjs && gjsify run check:test-bundle && gjsify run test:gjs",
        "test:gjs": "gjsify run dist/test.gjs.mjs",
        "test:node": "gjsify run build:test:node && node dist/test.node.mjs",
        "storybook": "gjsify storybook",
        "storybook:build": "gjsify storybook --build-only --out dist/storybook.gjs.mjs",
        "check:test-bundle": "gjs -m dev/check-test-bundle.js",
        "i18n:extract": "./dev/i18n.sh extract",
        "i18n:compile": "./dev/i18n.sh compile",
        "check:blp-handlers": "node dev/check-blp-handlers.js",
        "check:i18n": "node dev/check-i18n.js"
    },
    "optionalDependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.296",
