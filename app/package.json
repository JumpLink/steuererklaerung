                "lib/steuererklaerung/demo/transactions-data/fints_demo-musterbank-giro.ndjson": "demo/transactions-data/fints_demo-musterbank-giro.ndjson",
                "lib/steuererklaerung/demo/transactions-data/paypal_demo-fw.ndjson": "demo/transactions-data/paypal_demo-fw.ndjson",
                "lib/steuererklaerung/demo/transactions-data/qonto_demo-fw-geschaeft.ndjson": "demo/transactions-data/qonto_demo-fw-geschaeft.ndjson",
                "lib/steuererklaerung/demo/transactions-data/statements.json": "demo/transactions-data/statements.json"
            },
            "formats": {
                "deb": {
                    "bundledTypelibs": [
                        ".gda-stage/gi"
                    ],
                    "extraFiles": {
                        "lib/steuererklaerung/gda/lib/libgda-6.0/providers/libgda-sqlite-6.0.so": ".gda-stage/tree/usr/lib/steuererklaerung/gda/lib/libgda-6.0/providers/libgda-sqlite-6.0.so",
                        "lib/steuererklaerung/gda/share/libgda-6.0/information_schema.xml": ".gda-stage/tree/usr/lib/steuererklaerung/gda/share/libgda-6.0/information_schema.xml",
                        "lib/steuererklaerung/gda/share/libgda-6.0/dtd/libgda-array.dtd": ".gda-stage/tree/usr/lib/steuererklaerung/gda/share/libgda-6.0/dtd/libgda-array.dtd",
                        "lib/steuererklaerung/gda/share/libgda-6.0/dtd/libgda-db-catalog.dtd": ".gda-stage/tree/usr/lib/steuererklaerung/gda/share/libgda-6.0/dtd/libgda-db-catalog.dtd",
                        "lib/steuererklaerung/gda/share/libgda-6.0/dtd/libgda-paramlist.dtd": ".gda-stage/tree/usr/lib/steuererklaerung/gda/share/libgda-6.0/dtd/libgda-paramlist.dtd",
                        "lib/steuererklaerung/gda/share/libgda-6.0/dtd/libgda-server-operation.dtd": ".gda-stage/tree/usr/lib/steuererklaerung/gda/share/libgda-6.0/dtd/libgda-server-operation.dtd"
                    }
                }
            },
            "depends": {
                "deb": [
                    "libxml2-16",
                    "libsqlite3-0",
                    "gir1.2-freedesktop"
                ],
                "rpm": [
                    "libgda-sqlite"
                ]
            },
            "appId": "eu.jumplink.Steuererklaerung",
            "name": "Steuererklärung",
            "summary": "Taxes and bookkeeping",
            "description": [
                {
                    "p": "Receipts, transactions and invoices in one place. From them the app computes the income-surplus statement (EÜR), the VAT returns, trade tax and the separate assessment for partnerships, and files them through ELSTER."
                },
                {
                    "p": "It runs on your machine: your bank data and documents stay in a local store. Every figure can be traced back to the transaction it came from."
                },
                {
                    "p": "AI is optional: everything works without it. If you want help from an AI assistant, switch on the built-in MCP server and connect the assistant of your choice. It can read your books and, only if you allow it, make changes."
                },
                {
                    "p": "The tax logic follows German law, so the interface keeps the official German terms. The app is an early version and a preparation aid, not tax advice: check every return before you send it."
                }
            ],
            "icon": "data/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg",
            "categories": [
                "Office",
                "Finance"
            ],
            "keywords": [
                "Tax",
                "Accounting",
                "ELSTER",
                "EÜR",
                "VAT",
                "Invoice"
            ],
            "developer": {
                "id": "eu.jumplink",
                "name": "Pascal Garber"
            },
            "branding": {
                "accentLight": "#cfe5c8",
                "accentDark": "#2f5238"
            },
            "contentRating": "oars-1.1",
            "releases": [
                {
                    "version": "0.1.6",
                    "date": "2026-10-24",
                    "description": "The About dialog now links to the privacy policy and the legal notice. The MCP server binds to loopback by default."
                },
                {
                    "version": "0.1.5",
                    "date": "2026-10-23",
                    "description": "The README now names which parts of the app are written with AI. The Flatpak from Flathub comes without ERiC: export the return as XML and upload it in Mein ELSTER."
                },
                {
                    "version": "0.1.4",
                    "date": "2026-10-23",
                    "description": "The Flatpak bundle on the GitHub release page includes ERiC, so validating and submitting a return through ELSTER works from that download too."
                },
                {
                    "version": "0.1.3",
                    "date": "2026-10-23",
                    "description": "Restarting into the demo workspace works on macOS again, and the Flatpak builds with the current assistant libraries. The AI assistant stays switched off in this release."
                },
                {
                    "version": "0.1.2",
                    "date": "2026-10-22",
                    "description": "The AI assistant is optional and can be connected through the built-in MCP server — every provider supported by Lotse can be used, and free hosted models stay refused. The Linux packages ship their database libraries and the Flatpak carries the demo workspace, so install and first run work out of the box."
                },
                {
                    "version": "0.1.1",
                    "date": "2026-10-20",
                    "description": "Commands work in the installed app on Windows and macOS, Back up now no longer opens a second window, and error messages follow the interface language."
                },
                {
                    "version": "0.1.0",
                    "date": "2026-10-12",
                    "description": "First public release: receipts, transactions and invoices, the EÜR and VAT returns, and filing through ELSTER."
                }
            ],
