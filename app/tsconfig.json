{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // A `gjsify link`ed package is a symlink, and TS resolves a symlinked file's imports from its
    // REALPATH — so the linked checkout's own `@girs/*` join the program beside ours, and two copies
    // of one ambient `gi://` declaration are a duplicate-identifier conflict (measured: 120 errors
    // with the link vs 75 without, all of them inside @girs .d.ts files). Resolving from the symlink
    // path instead makes every linked package read OUR single copy.
    "preserveSymlinks": true
  },
  "include": ["./src/**/*", "./tests/**/*"]
}
