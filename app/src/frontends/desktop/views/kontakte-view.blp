using Gtk 4.0;
using Adw 1;

// Kontakte view body. Static chrome in Blueprint; the summary + contact rows are filled
// programmatically (see kontakte-view.ts).
template $BhKontakteView: Adw.Bin {
  Adw.BreakpointBin {
    width-request: 300;
    height-request: 200;

    // No rung any more, and that is the point: "Alle Kontakte" and the two header actions used to
    // share one line and the actions won — the title was allocated its ellipsis and nothing else,
    // so the section read "…", and a `max-width: 450px` rung blanked it. Since the header-bar
    // primary action (docs/app/mobile-layout.md) both actions are in the window header on a phone
    // and the row is the title's alone, so blanking it would leave an empty band instead.
    //
    // The bin stays for its size request. Should a rung come back here, mind that an in-view
    // breakpoint measures the CONTENT PANE, not the window: at a 1280 px desktop window that pane
    // is 537 px — measured off a screenshot, the content runs x=320…856 between the navigation and
    // the assistant panel — so a 560 px condition fires on the desktop. Stay below 537.
    child: Gtk.Stack stack {
      Gtk.StackPage {
        name: "loading";
        child: Gtk.Box {
          orientation: vertical;
          valign: center;
          halign: center;
          spacing: 12;

          Adw.Spinner {
            width-request: 32;
            height-request: 32;
          }

          Gtk.Label {
            label: _("Loading contacts …");
            styles ["dim-label"]
          }
        };
      }

      Gtk.StackPage {
        name: "error";
        child: Adw.StatusPage error_page {
          icon-name: "dialog-error-symbolic";
          title: _("Could not load");
        };
      }

      Gtk.StackPage {
        name: "content";
        child: Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          vexpand: true;

          child: Adw.Clamp {
            maximum-size: 900;
            tightening-threshold: 900;
            margin-top: 18;
            margin-bottom: 18;
            margin-start: 12;
            margin-end: 12;

            child: Gtk.Box {
              orientation: vertical;
              spacing: 18;

              Adw.PreferencesGroup summary_group {}

              // Filter chips (Alle · Kunden · Lieferanten) — a linked toggle group, filled in TS.
              // In a sideways scroller so the group never sets the window's minimum width; the
              // overlay scrollbar reserves no space, so the desktop looks the same.
              Gtk.ScrolledWindow {
                hscrollbar-policy: automatic;
                vscrollbar-policy: never;
                propagate-natural-width: true;

                child: Gtk.Box filter_box {
                  halign: start;
                  styles ["linked"]
                };
              }

              Adw.PreferencesGroup list_group {
                title: _("All contacts");
              }
            };
          };
        };
      }
    };
  }
}
