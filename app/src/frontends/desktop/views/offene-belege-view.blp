using Gtk 4.0;
using Adw 1;

// Offene Belege view body. Static chrome in Blueprint; the banner + per-month groups are filled
// programmatically (see offene-belege-view.ts).
template $BhOffeneBelegeView: Adw.Bin {
  Gtk.Stack stack {
    Gtk.StackPage {
      name: "loading";
      child: Gtk.Box {
        orientation: vertical;
        valign: center;
        halign: center;
        spacing: 12;

        Adw.Spinner {
          width-request: 32;
          height-request: 32;
        }

        Gtk.Label {
          label: "Suche fehlende Belege …";
          styles ["dim-label"]
        }
      };
    }

    Gtk.StackPage {
      name: "error";
      child: Adw.StatusPage error_page {
        icon-name: "dialog-error-symbolic";
        title: "Konnte nicht laden";
      };
    }

    Gtk.StackPage {
      name: "content";
      child: Gtk.ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        child: Adw.Clamp {
          maximum-size: 900;
          margin-top: 18;
          margin-bottom: 18;
          margin-start: 12;
          margin-end: 12;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 18;

            Adw.Banner gap_banner {
              revealed: false;
            }

            // Per-month Adw.PreferencesGroups are appended here.
            Gtk.Box months_box {
              orientation: vertical;
              spacing: 18;
            }
          };
        };
      };
    }
  }
}
