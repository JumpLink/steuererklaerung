using Gtk 4.0;
using Adw 1;

// Einstellungen view body. The switch rows are built programmatically (see einstellungen-view.ts)
// and persist to steuererklaerung.json on toggle.
template $BhEinstellungenView: Adw.Bin {
  child: Gtk.ScrolledWindow scroller {
    hscrollbar-policy: never;
    vexpand: true;

    child: Adw.Clamp {
      maximum-size: 800;
      margin-top: 18;
      margin-bottom: 18;
      margin-start: 12;
      margin-end: 12;

      child: Gtk.Box {
        orientation: vertical;
        spacing: 18;

        Adw.Banner save_banner {
          revealed: false;
        }

        // Per-entity groups (Anbindungen · Stammdaten) — built + rebuilt programmatically per active
        // entity/year in einstellungen-view.ts. Empty here; the global groups below build once.
        // Per-user groups (settings.json, not the manifest) — filled by einstellungen/allgemein.ts.
        Adw.PreferencesGroup general_group {
          title: _("General");
        }

        Adw.PreferencesGroup backup_group {
          title: _("Backup");
          description: _("A copy of your configuration, transactions and receipts. Restoring is done by hand, see the manual.");
        }

        Gtk.Box entity_groups {
          orientation: vertical;
          spacing: 18;
        }

        Adw.PreferencesGroup lernmodus_group {
          title: _("Clarity");
        }

        Adw.PreferencesGroup sync_group {
          title: C_("sync settings", "Sync");
          description: _("Fetches new data in the background. Bank fetches with TAN/PIN and ELSTER never run automatically.");
        }

        Adw.PreferencesGroup assistant_group {
          title: _("Assistant");
        }

        Adw.PreferencesGroup mcp_group {
          title: "MCP";
          description: _("Connect external assistants — changes take effect the next time the MCP server starts.");
        }

        Adw.PreferencesGroup groups_group {
          title: _("MCP tool groups");
          description: _("Which groups are visible to the outside.");
        }
      };
    };
  };
}
