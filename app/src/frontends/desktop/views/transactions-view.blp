using Gtk 4.0;
using Adw 1;

// Transaktionen view body. Static chrome in Blueprint; the summary + the transaction rows are
// filled programmatically (see transactions-view.ts) because they're data-driven.
template $BhTransactionsView: Adw.Bin {
  Gtk.Stack stack {
    Gtk.StackPage {
      name: "loading";
      child: Gtk.Box {
        orientation: vertical;
        valign: center;
        halign: center;
        spacing: 12;

        Adw.Spinner {
          width-request: 32;
          height-request: 32;
        }

        Gtk.Label {
          label: _("Loading transactions …");
          styles ["dim-label"]
        }
      };
    }

    Gtk.StackPage {
      name: "error";
      child: Adw.StatusPage error_page {
        icon-name: "dialog-error-symbolic";
        title: _("Could not load");
      };
    }

    Gtk.StackPage {
      name: "content";
      child: Gtk.ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        child: Adw.Clamp {
          maximum-size: 900;
          tightening-threshold: 900;
          margin-top: 18;
          margin-bottom: 18;
          margin-start: 12;
          margin-end: 12;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 18;

            Gtk.Box kpi_box {
              orientation: vertical;
            }

            Gtk.SearchEntry search_entry {
              placeholder-text: _("Search transactions …");
              hexpand: true;
            }

            // Filter chips (Alle · Einnahmen · Ausgaben · Ohne Beleg) — a linked toggle group, filled in TS.
            // Sideways scroller: four chips want ~400 px, which on a phone would be the minimum
            // width of the whole window (a Gtk.Stack measures every view it holds, not just the
            // visible one). The overlay scrollbar reserves no space, so the desktop is unchanged.
            Gtk.ScrolledWindow {
              hscrollbar-policy: automatic;
              vscrollbar-policy: never;
              propagate-natural-width: true;

              child: Gtk.Box filter_box {
                halign: start;
                styles ["linked"]
              };
            }

            Adw.PreferencesGroup list_group {}
          };
        };
      };
    }
  }
}
