using Gtk 4.0;
using Adw 1;

// Shell of the "Konto hinzufügen" dialog: a NavigationView whose pages are pushed from
// konto-hinzufuegen-dialog.ts (each page body is a form built there).
template $BhAddAccountDialog: Adw.Dialog {
  title: _("Konto hinzufügen");
  content-width: 560;
  content-height: 600;
  child: Adw.NavigationView nav {};
}
