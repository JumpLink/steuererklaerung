using Gtk 4.0;
using Adw 1;

// „Zu prüfen" tab of the Buchungen hub — the same split as the Beleg-Eingang: the queue with a
// progress line and the multi-select action on the left, the booking under review on the right.
// The rows and the detail are filled programmatically (see zu-pruefen-view.ts).
template $BhZuPruefenView: Adw.Bin {
  Gtk.Stack stack {
    Gtk.StackPage {
      name: "loading";
      child: Gtk.Box {
        orientation: vertical;
        valign: center;
        halign: center;
        spacing: 12;

        Adw.Spinner {
          width-request: 32;
          height-request: 32;
        }

        Gtk.Label {
          label: _("Loading transactions to review …");
          styles ["dim-label"]
        }
      };
    }

    Gtk.StackPage {
      name: "error";
      child: Adw.StatusPage error_page {
        icon-name: "dialog-error-symbolic";
        title: _("Could not load");
      };
    }

    Gtk.StackPage {
      name: "content";

      // The bin reports its own width-request as the minimum, so the queue's 260 px sidebar no
      // longer sets a floor for the whole window — a Gtk.Stack measures every page, visible or
      // not, and this view shares one with all the others.
      child: Adw.BreakpointBin {
        width-request: 300;
        height-request: 300;

        // 450 px, not 560: this condition measures the CONTENT PANE, not the window. At a 1280 px
        // desktop window that pane is only 537 px wide (see kontakte-view.blp), so a 560 px
        // condition collapsed the queue on the desktop too.
        Adw.Breakpoint {
          condition ("max-width: 450px")

          setters {
            split_view.collapsed: true;
            split_view.show-sidebar: false;
            queue_bar.visible: true;
          }
        }

        child: Adw.OverlaySplitView split_view {
          min-sidebar-width: 260;
          max-sidebar-width: 340;
          sidebar-width-fraction: 0.32;

          sidebar: Gtk.Box {
            orientation: vertical;

            Gtk.Box {
              orientation: vertical;
              spacing: 8;
              margin-top: 12;
              margin-bottom: 10;
              margin-start: 12;
              margin-end: 12;

              Gtk.Label progress_label {
                xalign: 0;
                styles ["dim-label", "caption"]
              }

              Gtk.ProgressBar progress_bar {}
            }

            Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              vexpand: true;

              child: Gtk.ListBox list_box {
                selection-mode: single;
                styles ["navigation-sidebar"]
              };
            }

            // Mehrfachauswahl: the check boxes in the rows feed this one action.
            Gtk.Button regel_button {
              label: _("Rule from selection");
              sensitive: false;
              margin-top: 8;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;
              tooltip-text: _("Suggest the common pattern of the marked transactions as a rule");

              styles ["pill"]
            }
          };

          content: Gtk.Box {
            orientation: vertical;

            // Only shown once the split view collapses: the queue is an overlay then and needs
            // a way back.
            Gtk.Box queue_bar {
              visible: false;
              margin-top: 6;
              margin-start: 12;
              margin-end: 12;

              Gtk.ToggleButton queue_toggle {
                icon-name: "sidebar-show-symbolic";
                tooltip-text: _("Show the queue");
                active: bind split_view.show-sidebar bidirectional;

                styles ["flat"]
              }
            }

            Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              vexpand: true;

              child: Adw.Clamp {
                maximum-size: 760;
                margin-top: 18;
                margin-bottom: 24;
                margin-start: 16;
                margin-end: 16;

                child: Gtk.Box detail_box {
                  orientation: vertical;
                  spacing: 18;
                };
              };
            }
          };
        };
      };
    }
  }
}
