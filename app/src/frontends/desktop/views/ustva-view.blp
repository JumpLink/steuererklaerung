using Gtk 4.0;
using Adw 1;

// USt-VA view body. Static chrome in Blueprint; one PreferencesGroup per quarter with data is
// built programmatically (see ustva-view.ts) from the USt-VA aggregate.
template $BhUstvaView: Adw.Bin {
  Gtk.Stack stack {
    Gtk.StackPage {
      name: "loading";
      child: Gtk.Box {
        orientation: vertical;
        valign: center;
        halign: center;
        spacing: 12;

        Adw.Spinner {
          width-request: 32;
          height-request: 32;
        }

        Gtk.Label {
          label: "Berechne USt-VA …";
          styles ["dim-label"]
        }
      };
    }

    Gtk.StackPage {
      name: "error";
      child: Adw.StatusPage error_page {
        icon-name: "dialog-error-symbolic";
        title: "Konnte nicht laden";
      };
    }

    Gtk.StackPage {
      name: "content";
      child: Gtk.ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        child: Adw.Clamp {
          maximum-size: 900;
          margin-top: 18;
          margin-bottom: 18;
          margin-start: 12;
          margin-end: 12;

          child: Gtk.Box quarters_box {
            orientation: vertical;
            spacing: 18;
          };
        };
      };
    }
  }
}
