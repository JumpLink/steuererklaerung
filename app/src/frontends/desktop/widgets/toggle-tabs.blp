using Gtk 4.0;

// The chip bar and the stack it drives. The chips themselves are added per call to `add()` — one
// per tab, from data — so they stay in TypeScript; what is declared here is the part that never
// changes. `Gtk.Stack`, not `Adw.ViewStack`, and NOT homogeneous: see toggle-tabs.ts for why.
template $BhToggleTabs: Gtk.Box {
  orientation: vertical;
  spacing: 14;

  // Sideways scroller: the chips (four tabs with status icons) want ~665 px, which on a phone was
  // the minimum width of the whole window. Overlay scrollbar, natural width kept: no desktop change.
  Gtk.ScrolledWindow {
    hscrollbar-policy: automatic;
    vscrollbar-policy: never;
    propagate-natural-width: true;

    child: Gtk.Box bar {
      homogeneous: true;
      hexpand: true;

      styles ["linked"]
    };
  }

  Gtk.Stack stack {
    vhomogeneous: false;
    hhomogeneous: false;
  }
}
