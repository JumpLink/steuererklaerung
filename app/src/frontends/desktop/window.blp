using Gtk 4.0;
using Adw 1;

menu primary_menu {
  item {
    // TRANSLATORS: Primary menu item opening the assistant that adds a further entity
    label: _("Set up entity …");
    action: "win.setup";
  }

  item {
    // TRANSLATORS: Primary menu item reopening the first-run introduction
    label: _("Welcome");
    action: "win.welcome";
  }

  item {
    // TRANSLATORS: Primary menu item listing the keyboard shortcuts
    label: _("Keyboard shortcuts");
    action: "win.shortcuts";
  }

  item {
    // TRANSLATORS: Primary menu item opening the about dialog. "Steuererklärung" is the
    // application name and stays untranslated.
    label: _("About Steuererklärung");
    action: "app.about";
  }

  item {
    // TRANSLATORS: Primary menu item that closes the application
    label: _("Quit");
    action: "app.quit";
  }
}

template $BhMainWindow: Adw.ApplicationWindow {
  width-request: 360;
  height-request: 480;

  // Collapse to a single pane on narrow widths (phone/tablet), like the web sidebar overlay.
  // In TypeScript each of these needed a boxed GObject.Value: `add_setter` takes one, and the
  // looser @girs typings happened to accept a raw boolean while the stricter ones do not.
  [breakpoint]
  Adw.Breakpoint {
    condition ("max-width: 720px")

    setters {
      split_view.collapsed: true;
    }
  }

  // The assistant panel docks side-by-side at >=1180px and overlays below that.
  //
  // Docked, it is 390 px wide — the width its example questions used to IMPOSE, back when they
  // were plain button labels that could not wrap: an AdwOverlaySplitView never gives its sidebar
  // less than the sidebar's own minimum, so the pills decided the panel width. Now that the pills
  // wrap (the whole point — they were also the window's floor on a phone), the width has to be
  // stated rather than inherited from a label, or the docked panel falls to the 0.32 fraction
  // (≈307 px) and wraps every question onto two lines. Only in this breakpoint: below it the panel
  // overlays, where 300 px is right and 390 would not fit a 360 px screen.
  //
  // 390 and not a round 420: every pixel here comes out of the content pane, which is what the
  // view toolbars have to fit into (1280 − 320 nav − 390 = 570). 424 looked harmless and clipped
  // the Verträge filter chips to "Alle | Aktiv | Frist na…" at the default desktop size.
  [breakpoint]
  Adw.Breakpoint {
    condition ("min-width: 1180px")

    setters {
      assistant_split.collapsed: false;
      assistant_split.min-sidebar-width: 390;
    }
  }

  content: Adw.NavigationSplitView split_view {
    min-sidebar-width: 260;
    max-sidebar-width: 340;
    // 0.2, not the default 0.25: the fraction asks for 320 px at a 1280 px window, and until this
    // branch it never got them — the content pane could not shrink, so it pushed the sidebar back
    // down to its 260 px minimum. Now that every view can give, the sidebar takes the 60 px it
    // always wanted and the content pane pays: the Verträge filter chips lost "Archiviert". So the
    // width that was an accident of the squeeze is now stated. Above ~1700 px the clamp at 340
    // takes over, exactly as before.
    sidebar-width-fraction: 0.2;

    sidebar: Adw.NavigationPage sidebar_page {
      tag: "sidebar";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          // No subtitle: it once read „Native preview", which told a user nothing and told a
          // visitor the app is unfinished. Which front-end they are looking at is a fact about
          // the project, not about their tax year.
          title-widget: Adw.WindowTitle sidebar_title {};

          [end]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            primary: true;
            menu-model: primary_menu;
          }
        }

        content: Gtk.Box {
          orientation: vertical;

          // Identity block over the nav (design): whose books, and which year, where the
          // navigation lives.
          Gtk.Box {
            orientation: vertical;
            spacing: 10;
            margin-top: 8;
            margin-bottom: 10;
            margin-start: 10;
            margin-end: 10;

            $BhEntitySwitcher entity_switcher {}

            $BhYearSwitcher year_switcher {}
          }

          Gtk.Separator {}

          Gtk.ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            child: Gtk.ListBox nav_list {
              selection-mode: single;

              styles ["navigation-sidebar"]
            };
          }
        };
      };
    };

    content: Adw.NavigationPage content_page {
      tag: "content";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          title-widget: Adw.WindowTitle content_title {};

          [end]
          Gtk.Button sync_button {
            icon-name: "view-refresh-symbolic";
            // TRANSLATORS: Tooltip on the headerbar button that syncs Qonto and Paperless
            tooltip-text: _("Sync");
          }

          [end]
          Gtk.ToggleButton assistant_toggle {
            icon-name: "starred-symbolic";
            // TRANSLATORS: Tooltip on the button revealing the AI assistant side panel
            tooltip-text: _("Assistant");
            // Two-way, so the panel's own close button unpresses the toggle.
            active: bind assistant_split.show-sidebar bidirectional;
          }
        }

        content: Adw.OverlaySplitView assistant_split {
          sidebar-position: end;
          collapsed: true;
          show-sidebar: false;
          min-sidebar-width: 300;
          max-sidebar-width: 460;
          sidebar-width-fraction: 0.32;

          // A ToastOverlay around the content so views and dialogs can show transient
          // confirmations from anywhere.
          content: Adw.ToastOverlay toast_overlay {
            child: Gtk.Box {
              orientation: vertical;

              Adw.Banner banner {
                revealed: false;
              }

              // The setup banner. Not an Adw.Banner: that has one button and no way to close it,
              // and this one needs both „Finish setup" and a close button.
              Gtk.ActionBar setup_bar {
                revealed: false;

                [start]
                Gtk.Box {
                  spacing: 12;
                  margin-start: 6;

                  Gtk.Image {
                    icon-name: "dialog-information-symbolic";
                  }

                  Gtk.Label setup_label {
                    wrap: true;
                    xalign: 0;
                  }
                }

                [end]
                Gtk.Button setup_close {
                  icon-name: "window-close-symbolic";
                  tooltip-text: _("Close");
                  valign: center;

                  styles [
                    "flat",
                    "circular",
                  ]
                }

                [end]
                Gtk.Button setup_finish {
                  label: _("Finish setup");
                  valign: center;

                  styles [
                    "suggested-action",
                    "pill",
                  ]
                }
              }

              Gtk.Stack stack {
                transition-type: crossfade;
                vexpand: true;
              }
            };
          };

          // Two assistant panes, one slot. The in-process one is declared here because it has
          // always been here; the lotse pane is appended in TypeScript and ONLY when the embed
          // plan says so (AI on + `aiEngine: 'lotse'`), so "no AI" means no pane and no
          // subprocess — not a hidden pane with a child behind it.
          sidebar: Gtk.Stack assistant_stack {
            Gtk.StackPage {
              name: "builtin";

              child: $BhAssistentPanel assistant_panel {};
            }
          };
        };
      };
    };
  };
}
