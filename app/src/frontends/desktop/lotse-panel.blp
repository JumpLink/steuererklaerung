using Gtk 4.0;
using Adw 1;

// The chrome around one LotseChat — everything except the chat itself, which is built in
// TypeScript from the embed plan and dropped into `chat_bin`.
template $BhLotsePanel: Gtk.Box {
  orientation: vertical;
  width-request: 320;

  Gtk.Box {
    orientation: horizontal;
    spacing: 8;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 14;
    margin-end: 10;

    Gtk.Image {
      icon-name: "starred-symbolic";

      styles ["accent"]
    }

    Gtk.Label {
      // TRANSLATORS: Title of the side panel holding the external coding agent
      label: _("Assistant");
      xalign: 0;
      hexpand: true;

      styles ["heading"]
    }

    Gtk.Button {
      icon-name: "window-close-symbolic";
      // TRANSLATORS: Tooltip on the button that hides the assistant panel
      tooltip-text: _("Close");

      styles ["flat", "circular"]

      clicked => $_onCloseClicked();
    }
  }

  Gtk.Separator {}

  Gtk.Box chat_bin {
    orientation: vertical;
    vexpand: true;
  }
}

// Declared OUTSIDE the template, like lotse's own shell does it: the chat parents this page into
// its `no-agent` slot, so it must not already have a parent here. A top-level object is still an
// internal child — bound by id and kept alive by the builder (lotse's window.blp records the
// measurement).
//
// The page is HERE and not inside the widget on purpose: lotse hands a host the sentences
// (`emptyStateView`) and lets the host say them in its own frame, because the copy around a chat
// belongs to whatever surrounds it. Title, description and the command are filled in TypeScript —
// never written twice.
Adw.StatusPage no_agent_page {
  icon-name: "dialog-warning-symbolic";
  vexpand: true;

  styles ["compact"]

  child: Gtk.Box {
    orientation: vertical;
    spacing: 12;
    halign: center;

    // The install command as a selectable monospace label, never markup: it is something to copy.
    Gtk.Label no_agent_command {
      selectable: true;
      wrap: true;
      wrap-mode: word_char;
      xalign: 0;

      styles ["monospace", "card"]
    }

    // Shown only where lotse's pinned opencode can be downloaded for this person; the label carries
    // the size so the click is an informed one (a confirmation dialog follows).
    Gtk.Button no_agent_install {
      visible: false;
      halign: center;

      styles ["suggested-action", "pill"]

      clicked => $_onInstallClicked();
    }

    Gtk.Label no_agent_install_status {
      visible: false;
      wrap: true;
      justify: center;

      styles ["dim-label"]
    }

    Gtk.LinkButton no_agent_docs {
      // TRANSLATORS: Link to the coding agent's own documentation
      label: _("Documentation");
      halign: center;
    }
  };
}
