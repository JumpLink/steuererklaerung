# System files
.DS_Store
Thumbs.db

# Private/Sensitive data (just in case)
*.key
*.pem
secrets.sh
.env

# Private tax/accounting documents (Finanzamt-Schreiben, ELSTER-Versandbestätigungen, Scans)
# Echte Belege dürfen nicht ins Repo – nur die Markdown-Doku unter docs/ wird getrackt.
docs/documents/

# Screenshots taken against the LIVE store show real client names, amounts, IBANs and tax
# numbers — a leak path no text scan finds. They stay local, always.
# The screenshots that ARE committed live in docs/screenshots/ and come exclusively from the
# fictional demo entity (app/demo/, STEUER_DEMO=1); docs/app/README.md documents how to
# regenerate them. Never point a committed image at this directory.
docs/app/screenshots/

# Design drafts + their screenshots. Same reason as above — they are captures of the LIVE
# store, and they are not documentation anyone else needs. Untracked is not enough: one
# `git add -A` before publication would sweep them in.
docs/entwurf/

# Temporary files
*.tmp
*.log

# NPM — this is a gjsify workspace; install with `gjsify install`, never `npm install`.
# A package-lock.json is a stray npm artifact (a per-child lock is wrong in a workspace anyway),
# so it must never be tracked or recreated.
node_modules
package-lock.json

# Build output (any level: cli/dist, packages/*/dist, packages/*/build)
dist/

# ─── ERiC (ELSTER Rich Client) — NON-redistributable; must NEVER be committed ───
# Licensed by Bayerisches Landesamt für Steuern; redistribution/sublicensing is
# forbidden and versions expire. Each user brings their own (see
# packages/eric/README.md). Defensive patterns so it can't leak from any path once
# this repo goes public (committed git history is forever). The committed code is
# only OUR wrapper (packages/eric/src), never ERiC binaries/headers/schemas.
ERiC-*/
ERiC-*.jar
ERiC-*.zip
**/eric/runtime/
**/eric/downloads/
**/prebuilds/
libericapi.so*
libotto.so*
libeSigner.so*
libericxerces.so*
libsteuereric.so*
SteuerEric-*.typelib
SteuerEric-*.gir
# Pre-rename names of the same three artefacts — a tree built before the rename still has them.
libbuchhaltungeric.so*
BuchhaltungEric-*.typelib
BuchhaltungEric-*.gir

# `gjsify ship` output — built artefacts, never committed.
app/ship/

# Regenerated by `app/dev/i18n.sh extract` from a `find` over src/, so it churns on every added
# file while carrying no information a checkout cannot reproduce. The .pot and the .po files ARE
# tracked -- a translator needs those without running extraction first.
app/po/POTFILES.in

# Generated by the Blueprint plugin on every build
*.d.blp.ts
