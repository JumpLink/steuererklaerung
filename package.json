   "developer": {
    "id": "eu.jumplink",
    "name": "Pascal Garber",
    "email": "pascal@jumplink.eu"
   },
   "summary": "Bookkeeping and tax returns for a small German business",
   "summaryTranslatorHint": "One line, no full stop: what the app does for the person using it",
   "description": [
    {
     "p": "Receipts, bookings and invoices in one place — and out of them the German income surplus statement (EÜR), the VAT return, trade tax and the partnership assessment, as ELSTER XML or transmitted directly.",
     "translatorHint": "Opening paragraph: what the app does. Keep EÜR and ELSTER as they are."
    },
    {
     "p": "Works without AI: your own classification rules instead of guessing, and every figure traceable down to the booking it came from. No figure depends on a model.",
     "translatorHint": "Second paragraph: the app works without AI, and the AI boundary"
    },
    {
     "ul": [
      {
       "item": "Import bank statements and receipts, classify them by your own rules",
       "translatorHint": "Feature list: import and classification"
      },
      {
       "item": "Write invoices as PDF and e-invoice (XRechnung, ZUGFeRD)",
       "translatorHint": "Feature list: invoicing. Keep XRechnung and ZUGFeRD as they are."
      },
      {
       "item": "Compute EÜR, VAT return, trade tax and the partnership assessment",
       "translatorHint": "Feature list: the tax forms. Keep EÜR as it is."
      },
      {
       "item": "Transmit to the tax office through ELSTER, or export the XML and keep it",
       "translatorHint": "Feature list: ELSTER submission. Keep ELSTER as it is."
      }
     ],
     "translatorHint": "Bullet list of what the app does"
    }
   ],
   "license": {
    "project": "AGPL-3.0-or-later"
   },
