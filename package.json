   "releases": [
    {
     "version": "0.1.7",
     "date": "2026-10-25",
     "description": [
      {
       "p": "The macOS and Windows packages now include GTK, so the app starts without a separately installed GTK. Empty totals no longer show a minus sign.",
       "translatorHint": "Release notes for 0.1.7 — the one-line summary"
      }
     ]
    },
    {
     "version": "0.1.6",
     "date": "2026-10-24",
     "description": [
      {
       "p": "The About dialog now links to the privacy policy and the legal notice. The MCP server binds to loopback by default.",
       "translatorHint": "Release notes for 0.1.6 — the one-line summary"
      }
     ]
    },
    {
     "version": "0.1.5",
     "date": "2026-10-23",
     "description": [
      {
       "p": "The README now names which parts of the app are written with AI. The Flatpak from Flathub comes without ERiC: export the return as XML and upload it in Mein ELSTER.",
       "translatorHint": "Release notes for 0.1.5 — the one-line summary"
      }
     ]
    },
    {
     "version": "0.1.4",
     "date": "2026-10-23",
     "description": [
      {
       "p": "The Flatpak bundle on the GitHub release page includes ERiC, so validating and submitting a return through ELSTER works from that download too.",
       "translatorHint": "Release notes for 0.1.4 — the one-line summary"
      }
     ]
    },
    {
     "version": "0.1.3",
     "date": "2026-10-23",
     "description": [
      {
       "p": "Restarting into the demo workspace works on macOS again, and the Flatpak builds with the current assistant libraries. The AI assistant stays switched off in this release.",
       "translatorHint": "Release notes for 0.1.3 — the one-line summary"
      }
     ]
    },
    {
     "version": "0.1.2",
     "date": "2026-10-22",
     "description": [
      {
       "p": "The AI assistant is optional and can be connected through the built-in MCP server — every provider supported by Lotse can be used, and free hosted models stay refused. The Linux packages ship their database libraries and the Flatpak carries the demo workspace, so install and first run work out of the box.",
       "translatorHint": "Release notes for 0.1.2 — the one-line summary"
      }
     ]
    },
    {
     "version": "0.1.1",
     "date": "2026-10-20",
     "description": [
      {
       "p": "Commands work in the installed app on Windows and macOS, Back up now no longer opens a second window, and error messages follow the interface language.",
       "translatorHint": "Release notes for 0.1.1 — the one-line summary"
      }
     ]
    },
    {
     "version": "0.1.0",
     "date": "2026-10-12",
     "description": [
      {
       "p": "First packaged release: bookkeeping, invoicing and the German tax forms in one window.",
       "translatorHint": "Release notes for 0.1.0 — the one-line summary"
      }
     ]
    }
   ],
   "modules": [
    {
     "name": "opencode",
     "buildsystem": "simple",
     "build-commands": [
      "install -Dm755 apply_extra /app/bin/apply_extra"
     ],
     "sources": [
      {
       "type": "extra-data",
       "filename": "opencode.tar.gz",
       "only-arches": [
        "x86_64"
       ],
       "url": "https://registry.npmjs.org/@opencode/cli-linux-x64/-/cli-linux-x64-2.0.22.tgz",
       "sha256": "65434cbe256f23df397a4941039e5eee28b1a37c1bad5376a5217f583a353583",
       "size": 90535245
      },
      {
       "type": "extra-data",
       "filename": "opencode.tar.gz",
       "only-arches": [
        "aarch64"
       ],
       "url": "https://registry.npmjs.org/@opencode/cli-linux-arm64/-/cli-linux-arm64-2.0.22.tgz",
       "sha256": "49e5466de60f65001cddd7583419f842140697daead2b4d8826be54d9056e70b",
       "size": 89333887
      },
      {
       "type": "script",
       "dest-filename": "apply_extra",
       "commands": [
        "set -e",
        "mkdir -p /app/extra/agents/opencode",
        "tar -xzf /app/extra/opencode.tar.gz -C /app/extra/agents/opencode",
        "chmod 0755 /app/extra/agents/opencode/package/bin/opencode",
        "rm -f /app/extra/opencode.tar.gz"
       ]
      }
     ]
    },
    {
     "name": "intltool",
     "cleanup": [
      "*"
     ],
     "sources": [
      {
       "type": "archive",
       "url": "https://launchpad.net/intltool/trunk/0.51.0/+download/intltool-0.51.0.tar.gz",
       "sha256": "67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd"
      }
     ]
    },
    {
     "name": "libgda",
     "buildsystem": "meson",
     "config-opts": [
      "-Dui=false",
      "-Dhelp=false",
      "-Djson=true",
      "-Dsqlcipher=false",
      "-Dlibsoup=false",
      "-Dlibsecret=false",
      "-Dexamples=false",
      "-Dtools=false",
      "-Ddoc=false",
      "-Dldap=false",
      "-Dweb=false"
     ],
     "cleanup": [
      "/include",
      "/lib/pkgconfig",
      "/share/gtk-doc",
      "/bin"
     ],
     "sources": [
      {
       "type": "archive",
       "url": "https://download.gnome.org/sources/libgda/6.0/libgda-6.0.0.tar.xz",
       "sha256": "995f4b420e666da5c8bac9faf55e7aedbe3789c525d634720a53be3ccf27a670"
      }
     ]
    },
    {
     "name": "steuererklaerung",
     "buildsystem": "simple",
     "build-commands": [
      "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs install --immutable",
      "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace steuererklaerung-cli i18n:compile",
      "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace steuererklaerung-cli build:app:flathub",
      "install -d /app/bin",
      "printf '#!/usr/bin/gjs -m\\n' > /app/bin/steuererklaerung",
      "cat app/dist/app/steuer-app.gjs.mjs >> /app/bin/steuererklaerung",
      "chmod 0755 /app/bin/steuererklaerung",
      "install -d /app/lib/girepository-1.0",
      "install -m644 node_modules/@gjsify/http-soup-bridge-linux-x64/prebuilds/linux-x64/GjsifyHttpSoupBridge-1.0.typelib /app/lib/girepository-1.0/",
      "install -m755 node_modules/@gjsify/http-soup-bridge-linux-x64/prebuilds/linux-x64/libgjsifyhttpsoupbridge.so /app/lib/",
      "install -d /app/share/locale",
      "cp -r app/dist/locale/. /app/share/locale/",
      "install -Dm644 app/data/eu.jumplink.Steuererklaerung.desktop /app/share/applications/eu.jumplink.Steuererklaerung.desktop",
      "install -Dm644 app/data/eu.jumplink.Steuererklaerung.metainfo.xml /app/share/metainfo/eu.jumplink.Steuererklaerung.metainfo.xml",
      "install -Dm644 app/data/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg /app/share/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg",
      "install -Dm644 app/data/icons/hicolor/symbolic/apps/eu.jumplink.Steuererklaerung-symbolic.svg /app/share/icons/hicolor/symbolic/apps/eu.jumplink.Steuererklaerung-symbolic.svg"
     ],
     "sources": [
      {
       "type": "git",
       "path": ".",
       "branch": "HEAD",
       "disable-submodules": true
      },
      {
       "type": "file",
       "path": "build-aux/gjsify.gjs.mjs"
      },
      "gjsify-sources.json"
     ]
    }
   ]
  }
 },
 "scripts": {
