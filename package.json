   "defaultLanguage": "de",
   "repository": "JumpLink/steuererklaerung",
   "translations": "app/po",
   "icon": "app/data/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg",
   "releaseAssets": false,
   "downloads": [
    {
     "platform": "linux",
     "format": "source",
     "url": "https://github.com/JumpLink/steuererklaerung#install-and-build"
    }
