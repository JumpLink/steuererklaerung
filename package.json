  "dev:app": "gjsify workspace steuererklaerung-cli dev:app",
  "storybook": "gjsify workspace steuererklaerung-cli storybook",
  "check": "gjsify foreach -A check",
  "test": "gjsify workspace steuererklaerung-cli test",
  "format": "gjsify workspace steuererklaerung-cli format",
  "lint": "gjsify workspace steuererklaerung-cli lint"
 }
}
