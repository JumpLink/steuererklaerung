   "appId": "eu.jumplink.Steuererklaerung",
   "icon": "app/data/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg",
   "kind": "app",
   "name": "Steuererklärung",
   "command": "steuererklaerung",
