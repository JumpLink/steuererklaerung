 "description": "steuererklaerung workspace: the app (CLI · web · MCP · native, on Node + GJS) + local packages (e.g. eric)",
 "workspaces": [
  "app",
  "packages/*"
 ],
 "gjsify": {
  "site": {
   "metainfo": "app/data/eu.jumplink.Steuererklaerung.metainfo.xml",
