  "flatpak": {
   "appId": "eu.jumplink.Steuererklaerung",
   "icon": "app/data/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg",
   "kind": "app",
   "name": "Steuererklärung",
   "command": "steuererklaerung",
   "runtime": "gnome",
   "runtimeVersion": "50",
   "sdkExtensions": [
    "org.freedesktop.Sdk.Extension.node24",
    "org.freedesktop.Sdk.Extension.typescript"
   ],
   "finishArgs": [
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.secrets",
    "--env=GJSIFY_LOCALE_DIR=/app/share/locale"
   ],
   "developer": {
    "id": "eu.jumplink",
    "name": "Pascal Garber",
    "email": "pascal@jumplink.eu"
   },
   "summary": "Bookkeeping and tax returns for a small German business",
   "summaryTranslatorHint": "One line, no full stop: what the app does for the person using it",
   "description": [
    {
     "p": "Receipts, bookings and invoices in one place — and out of them the German income surplus statement (EÜR), the VAT return, trade tax and the partnership assessment, as ELSTER XML or transmitted directly.",
     "translatorHint": "Opening paragraph: what the app does. Keep EÜR and ELSTER as they are."
    },
    {
     "p": "Fully usable without AI: your own classification rules instead of guessing, and every figure traceable down to the booking it came from. An assistant can help, but it never books anything by itself.",
     "translatorHint": "Second paragraph: the app works without AI, and the AI boundary"
    },
    {
     "ul": [
      {
       "item": "Import bank statements and receipts, classify them by your own rules",
       "translatorHint": "Feature list: import and classification"
      },
      {
       "item": "Write invoices as PDF and e-invoice (XRechnung, ZUGFeRD)",
       "translatorHint": "Feature list: invoicing. Keep XRechnung and ZUGFeRD as they are."
      },
      {
       "item": "Compute EÜR, VAT return, trade tax and the partnership assessment",
       "translatorHint": "Feature list: the tax forms. Keep EÜR as it is."
      },
      {
       "item": "Transmit to the tax office through ELSTER, or export the XML and keep it",
       "translatorHint": "Feature list: ELSTER submission. Keep ELSTER as it is."
      }
     ],
     "translatorHint": "Bullet list of what the app does"
    }
   ],
   "license": {
    "project": "AGPL-3.0-or-later"
   },
   "homepageUrl": "https://github.com/JumpLink/steuererklaerung",
   "bugtrackerUrl": "https://github.com/JumpLink/steuererklaerung/issues",
   "vcsBrowserUrl": "https://github.com/JumpLink/steuererklaerung",
   "categories": [
    "Office",
    "Finance",
    "GTK"
   ],
   "keywords": [
    "Steuer",
    "Buchhaltung",
    "ELSTER",
    "EÜR",
    "Umsatzsteuer",
    "Rechnung",
    "Tax"
   ],
   "contentRating": {
    "type": "oars-1.1",
    "attributes": {}
   },
   "kudos": [
    "ModernToolkit",
    "HiDpiIcon"
   ],
   "provides": {
    "binaries": [
     "steuererklaerung"
    ]
   },
   "releases": [
    {
     "version": "0.1.0",
     "date": "2026-10-12",
     "description": [
      {
       "p": "First packaged release: bookkeeping, invoicing and the German tax forms in one window.",
       "translatorHint": "Release notes for 0.1.0 — the one-line summary"
      }
     ]
    }
   ],
   "modules": [
    {
     "name": "opencode",
     "buildsystem": "simple",
     "build-commands": [
      "install -Dm755 apply_extra /app/bin/apply_extra"
     ],
     "sources": [
      {
       "type": "extra-data",
       "filename": "opencode.tar.gz",
       "only-arches": [
        "x86_64"
       ],
       "url": "https://registry.npmjs.org/@opencode/cli-linux-x64/-/cli-linux-x64-2.0.22.tgz",
       "sha256": "65434cbe256f23df397a4941039e5eee28b1a37c1bad5376a5217f583a353583",
       "size": 90535245
      },
      {
       "type": "extra-data",
       "filename": "opencode.tar.gz",
       "only-arches": [
        "aarch64"
       ],
       "url": "https://registry.npmjs.org/@opencode/cli-linux-arm64/-/cli-linux-arm64-2.0.22.tgz",
       "sha256": "49e5466de60f65001cddd7583419f842140697daead2b4d8826be54d9056e70b",
       "size": 89333887
      },
      {
       "type": "script",
       "dest-filename": "apply_extra",
       "commands": [
        "set -e",
        "mkdir -p /app/extra/agents/opencode",
        "tar -xzf /app/extra/opencode.tar.gz -C /app/extra/agents/opencode",
        "chmod 0755 /app/extra/agents/opencode/package/bin/opencode",
        "rm -f /app/extra/opencode.tar.gz"
       ]
      }
     ]
    },
    {
     "name": "intltool",
     "cleanup": [
      "*"
     ],
     "sources": [
      {
       "type": "archive",
       "url": "https://launchpad.net/intltool/trunk/0.51.0/+download/intltool-0.51.0.tar.gz",
       "sha256": "67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd"
      }
     ]
    },
    {
     "name": "libgda",
     "buildsystem": "meson",
     "config-opts": [
      "-Dui=false",
      "-Dhelp=false",
      "-Djson=true",
      "-Dsqlcipher=false",
      "-Dlibsoup=false",
      "-Dlibsecret=false",
      "-Dexamples=false",
      "-Dtools=false",
      "-Ddoc=false",
      "-Dldap=false",
      "-Dweb=false"
     ],
     "cleanup": [
      "/include",
      "/lib/pkgconfig",
      "/share/gtk-doc",
      "/bin"
     ],
     "sources": [
      {
       "type": "archive",
       "url": "https://download.gnome.org/sources/libgda/6.0/libgda-6.0.0.tar.xz",
       "sha256": "995f4b420e666da5c8bac9faf55e7aedbe3789c525d634720a53be3ccf27a670"
      }
     ]
    },
    {
     "name": "steuererklaerung",
     "buildsystem": "simple",
     "build-commands": [
      "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs install --immutable",
      "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace steuererklaerung-cli i18n:compile",
      "STEUER_CHANNEL=flathub XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace steuererklaerung-cli build:app",
      "install -d /app/bin",
      "printf '#!/usr/bin/gjs -m\\n' > /app/bin/steuererklaerung",
      "cat app/dist/app/steuer-app.gjs.mjs >> /app/bin/steuererklaerung",
      "chmod 0755 /app/bin/steuererklaerung",
      "install -d /app/lib/girepository-1.0",
      "install -m644 node_modules/@gjsify/http-soup-bridge-linux-x64/prebuilds/linux-x64/GjsifyHttpSoupBridge-1.0.typelib /app/lib/girepository-1.0/",
      "install -m755 node_modules/@gjsify/http-soup-bridge-linux-x64/prebuilds/linux-x64/libgjsifyhttpsoupbridge.so /app/lib/",
      "install -d /app/share/locale",
      "cp -r app/dist/locale/. /app/share/locale/",
      "install -Dm644 app/data/eu.jumplink.Steuererklaerung.desktop /app/share/applications/eu.jumplink.Steuererklaerung.desktop",
      "install -Dm644 app/data/eu.jumplink.Steuererklaerung.metainfo.xml /app/share/metainfo/eu.jumplink.Steuererklaerung.metainfo.xml",
      "install -Dm644 app/data/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg /app/share/icons/hicolor/scalable/apps/eu.jumplink.Steuererklaerung.svg",
      "install -Dm644 app/data/icons/hicolor/symbolic/apps/eu.jumplink.Steuererklaerung-symbolic.svg /app/share/icons/hicolor/symbolic/apps/eu.jumplink.Steuererklaerung-symbolic.svg"
     ],
     "sources": [
      {
       "type": "git",
       "path": ".",
       "branch": "HEAD",
       "disable-submodules": true
      },
      {
       "type": "file",
       "path": "build-aux/gjsify.gjs.mjs"
      },
      "gjsify-sources.json"
     ]
    }
   ]
  }
 },
 "scripts": {
  "build": "gjsify workspace steuererklaerung-cli build",
  "build:cli": "gjsify workspace steuererklaerung-cli build:gjs",
  "build:app": "gjsify workspace steuererklaerung-cli build:app",
  "build:web": "gjsify workspace steuererklaerung-cli build:web",
  "start": "gjsify workspace steuererklaerung-cli start",
  "start:app": "gjsify workspace steuererklaerung-cli start:app",
  "start:web": "gjsify workspace steuererklaerung-cli start web",
  "dev:app": "gjsify workspace steuererklaerung-cli dev:app",
  "storybook": "gjsify workspace steuererklaerung-cli storybook",
  "check": "gjsify foreach -A check",
  "test": "gjsify workspace steuererklaerung-cli test",
  "format": "gjsify workspace steuererklaerung-cli format",
  "lint": "gjsify workspace steuererklaerung-cli lint"
 }
}
